{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Importer les licenciés FFTA{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h3 class="mb-0">
                            <em class="fa-solid fa-file-csv me-2"></em>
                            Importer les licenciés FFTA
                        </h3>
                    </div>
                    <div class="card-body">
                        <p>
                            Importez l’export CSV officiel de l’Espace dirigeant. Les lignes actives seront analysées
                            avant toute modification ; vous pourrez vérifier chaque création de compte sur l’écran suivant.
                        </p>

                        {{ form_start(form) }}
                            {{ form_row(form.csv) }}
                            <div class="d-flex justify-content-between">
                                <a href="{{ path('app_licensee_new_choice') }}" class="btn btn-secondary">
                                    <em class="fa-solid fa-arrow-left me-2"></em>
                                    Retour
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    Analyser le fichier
                                    <em class="fa-solid fa-arrow-right ms-2"></em>
                                </button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
