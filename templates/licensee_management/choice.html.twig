{% extends 'base.html.twig' %}

{% block title %}Ajouter / renouveler un licencié{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <em class="fa-solid fa-user-plus me-2"></em>
                        Ajouter ou renouveler un licencié
                    </h3>
                </div>
                <div class="card-body">
                    <p class="lead">Saisissez le code licence FFTA du licencié pour renouveler sa licence ou récupérer ses informations.</p>

                    {% if not_found_code is defined %}
                        <div class="alert alert-warning d-flex justify-content-between align-items-center" role="alert">
                            <div>
                                <em class="fa-solid fa-triangle-exclamation me-2"></em>
                                Aucun licencié trouvé pour le code <strong>{{ not_found_code }}</strong>.
                            </div>
                            <a href="{{ path('app_licensee_new_manual', {ffta_member_code: not_found_code}) }}" class="btn btn-warning btn-sm text-nowrap ms-3">
                                <em class="fa-solid fa-user-plus me-2"></em>
                                Créer ce licencié
                            </a>
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_licensee_new_choice') }}">
                        <div class="mb-3">
                            <label for="ffta_member_code" class="form-label">Code licence FFTA</label>
                            <input type="text" class="form-control" id="ffta_member_code" name="ffta_member_code"
                                   value="{{ not_found_code|default('') }}"
                                   placeholder="7 ou 8 caractères" maxlength="8" pattern="[A-Za-z0-9]{7,8}">
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_licensee_index') }}" class="btn btn-secondary">
                                <em class="fa-solid fa-arrow-left me-2"></em>
                                Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                Rechercher
                                <em class="fa-solid fa-magnifying-glass ms-2"></em>
                            </button>
                        </div>
                    </form>

                    <hr class="my-4">

                    <p class="mb-0">
                        Vous ne connaissez pas le code licence, ou le licencié n'en a pas encore ?
                        <a href="{{ path('app_licensee_new_manual') }}">Créer manuellement</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
