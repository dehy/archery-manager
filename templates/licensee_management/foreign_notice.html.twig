{% extends 'base.html.twig' %}

{% block title %}Licencié introuvable dans votre club{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-warning">
                    <h3 class="mb-0">
                        <em class="fa-solid fa-triangle-exclamation me-2"></em>
                        Licencié d'un autre club
                    </h3>
                </div>
                <div class="card-body">
                    {# Only identity is shown: this licensee has no license history with the admin's club. #}
                    <p class="lead mb-1">{{ licensee.firstname }} {{ licensee.lastname }}</p>
                    <p class="text-muted">Né(e) le {{ licensee.birthdate|date('d/m/Y') }}</p>

                    <p class="mt-3">
                        Ce code correspond à un licencié qui n'a jamais eu de licence dans votre club.
                        Pour l'accueillir, invitez-le à soumettre une demande d'adhésion à votre club.
                    </p>

                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_licensee_new_choice') }}" class="btn btn-secondary">
                            <em class="fa-solid fa-arrow-left me-2"></em>
                            Retour
                        </a>
                        <a href="{{ path('app_licensee_index') }}" class="btn btn-primary">
                            Licenciés du club
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
