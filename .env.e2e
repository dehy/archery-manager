# Browser tests (Playwright, docker-compose.e2e.yml): the app runs as in production (no debug, built assets)
# against its own database (doctrine dbname_suffix `_e2e`) and sends its e-mails to Mailpit.
APP_DEBUG=0
APP_SECRET='$ecretf0re2e'
APP_URL=http://archery-manager
DATABASE_URL="mysql://symfony:ChangeMe@database:3306/app?serverVersion=12.1.2-MariaDB&charset=utf8mb4"
MAILER_DSN=smtp://mailpit:1025
MESSENGER_TRANSPORT_DSN=sync://
LOCK_DSN=flock
REDIS_DSN=redis://redis:6379
FRIENDLY_CAPTCHA_SITE_KEY=test-site-key
FRIENDLY_CAPTCHA_SECRET=test-secret
